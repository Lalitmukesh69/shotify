{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "shotify",
  "mainBinaryName": "shotify",
  "version": "1.0.0",
  "identifier": "com.shotify.app",
  "build": {
    "beforeDevCommand": "node ./scripts/tauri-before-dev.js",
    "beforeBuildCommand": "node ./scripts/tauri-before-build.js",
    "devUrl": "http://localhost:3002",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "shotify",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 49, "y": 48 }
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/Pictures/**",
          "$HOME/Downloads/**",
          "/tmp/**",
          "$TEMP/**",
          "/usr/share/backgrounds/**",
          "/usr/share/wallpapers/**",
          "/usr/local/share/backgrounds/**",
          "/usr/local/share/wallpapers/**",
          "$HOME/.local/share/backgrounds/**",
          "$HOME/.local/share/wallpapers/**",
          "$HOME/.cache/com.shotify.app/**",
          "$HOME/.local/share/com.shotify.app/**",
          "$HOME/AppData/Local/Temp/**",
          "$HOME/AppData/Roaming/Microsoft/Windows/Themes/**",
          "$HOME/AppData/Local/Microsoft/Windows/Themes/**",
          "C:/Windows/Web/**",
          "$HOME/Library/Caches/shotstyle/tmp/**",
          "$HOME/Library/Caches/com.shotstyle.app/**",
          "$HOME/Library/Caches/com.shotify.app/**",
          "/System/Library/Desktop Pictures/**",
          "/System/Library/Desktop Pictures/.thumbnails/**",
          "/System/Library/Desktop Pictures/.wallpapers/**",
          "/Library/Desktop Pictures/**",
          "$HOME/**/build-temp/shotstyle-cache/**",
          "$DESKTOP/**/build-temp/shotstyle-cache/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "license": "GPL-3.0",
    "licenseFile": "../LICENSE",
    "shortDescription": "Screenshot capture, styling, and annotation tool",
    "longDescription": "shotify is a desktop app for turning screenshots into polished, annotated, presentation-ready images across Linux, macOS, and Windows.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all"
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
