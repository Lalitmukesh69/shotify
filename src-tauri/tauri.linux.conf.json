{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "shotify",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false
      }
    ]
  },
  "bundle": {
    "linux": {
      "deb": {
        "recommends": [
          "grim",
          "wl-clipboard",
          "xdg-desktop-portal"
        ]
      },
      "rpm": {
        "recommends": [
          "grim",
          "wl-clipboard",
          "xdg-desktop-portal"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
